{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "client",
      "framework": "vite",
      "routes": [
        {
          "handle": "filesystem"
        },
        {
          "src": "/.*",
          "dest": "/index.html"
        }
      ]
    },
    "server": {
      "root": "server",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/api",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/:path*",
      "destination": {
        "service": "client"
      }
    },
    {
      "source": "/",
      "destination": {
        "service": "client"
      }
    }
  ]
}
