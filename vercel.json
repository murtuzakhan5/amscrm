{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "client",
      "framework": "vite"
    },
    "server": {
      "root": "server",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/api",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/assets/:path*",
      "destination": {
        "service": "client"
      }
    },
    {
      "source": "/:file.:ext",
      "destination": {
        "service": "client"
      }
    },
    {
      "source": "/:path*",
      "destination": {
        "service": "client",
        "path": "/index.html"
      }
    },
    {
      "source": "/",
      "destination": {
        "service": "client",
        "path": "/index.html"
      }
    }
  ]
}
