# ==========================================
# AMS Crafters CRM & Employee Management System
# Environment Configuration Template
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Client URL (For CORS & Cookie SameSite handling)
CLIENT_URL=http://localhost:5173

# Database Configuration
# Provide a MongoDB Atlas URI or local MongoDB connection string:
MONGODB_URI=mongodb://127.0.0.1:27017/ams_crafters_crm
# Optional: Set to true if local MongoDB daemon is not running; automatically spins up in-memory MongoDB
USE_IN_MEMORY_DB=true

# Authentication Secrets (Generate secure 64+ char random strings for production)
JWT_ACCESS_SECRET=ams_crafters_access_token_secret_key_super_secure_2026_dev
JWT_REFRESH_SECRET=ams_crafters_refresh_token_secret_key_super_secure_2026_dev
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Initial Super Admin Seed Credentials (Used only by scripts/seedSuperAdmin.js)
INITIAL_ADMIN_NAME="AMS Super Admin"
INITIAL_ADMIN_EMAIL="admin@amscrafters.com"
INITIAL_ADMIN_PASSWORD="AdminPassword123!"
INITIAL_ADMIN_PHONE="+92 300 1234567"

# Email Configuration (Nodemailer SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@amscrafters.com
SMTP_PASSWORD=your_email_app_password
EMAIL_FROM="AMS Crafters <no-reply@amscrafters.com>"

# Timezone & Company Defaults
DEFAULT_TIMEZONE=Asia/Karachi
DEFAULT_CURRENCY=USD
